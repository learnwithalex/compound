# Postgres (from Orizon managed DB)
DATABASE_URL="postgres://user:pass@host:5432/booked"

# Anthropic (for categorisation agent)
ANTHROPIC_API_KEY=""

# Plaid (bank feeds)
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"

# Stripe (revenue ingestion — OAuth for connecting user accounts)
STRIPE_CLIENT_ID=""
STRIPE_SECRET_KEY=""

# Orizon transactional email (magic-link delivery).
# The EMAIL_FROM domain must be verified for your team under /v1/email/domains.
ORIZON_EMAIL_API_KEY=""
EMAIL_FROM="Booked <noreply@send.orizon.ng>"

# Auth
SESSION_SECRET="change-me-32-bytes-min"
APP_URL="http://localhost:3000"
